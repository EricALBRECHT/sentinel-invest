# Replace the placeholder with a real application name and a contact email.
# SEC EDGAR rejects clients that do not identify themselves.
SEC_USER_AGENT=Sentinel senticontact@free.fr

# How long a successful SEC sync stays fresh, and how often the scheduler looks for due companies.
SEC_SYNC_INTERVAL_HOURS=24
SEC_SYNC_SCAN_HOURS=6
SEC_SYNC_MAX_COMPANIES_PER_RUN=50

# How often the scheduler enqueues a universe priority refresh, and when a company is stale.
UNIVERSE_PRIORITY_INTERVAL_HOURS=24
UNIVERSE_STALE_DAYS=365

# Public index imports (S&P 500 / Nasdaq-100 via Wikipedia MediaWiki).
UNIVERSE_USER_AGENT=SentinelResearchBot/1.0 (universe-importer; contact@example.com)
UNIVERSE_TIMEOUT_SECONDS=30
UNIVERSE_MAX_RETRIES=3
UNIVERSE_MIN_INTERVAL_SECONDS=1
UNIVERSE_BOOTSTRAP_MAX_PER_RUN=25
UNIVERSE_MEMBERS_REFRESH_DAYS=7
UNIVERSE_BOOTSTRAP_SCAN_HOURS=1

# Daily market history. V1 uses the Yahoo Finance chart endpoint behind MarketDataProvider.
MARKET_PROVIDER=yahoo
MARKET_USER_AGENT=Sentinel market-data contact@example.com
MARKET_TIMEOUT_SECONDS=30
MARKET_MAX_RETRIES=3
MARKET_MIN_INTERVAL_SECONDS=1
MARKET_HISTORY_YEARS=10
MARKET_SYNC_INTERVAL_HOURS=24
MARKET_SYNC_SCAN_HOURS=24
MARKET_SYNC_MAX_COMPANIES_PER_RUN=200

# News and other external documents. V1 polls official RSS and the SEC submissions API.
INTELLIGENCE_USER_AGENT=Sentinel news-collector contact@example.com
INTELLIGENCE_TIMEOUT_SECONDS=20
INTELLIGENCE_MAX_RETRIES=3
INTELLIGENCE_MIN_INTERVAL_SECONDS=1
INTELLIGENCE_LOOKBACK_DAYS=7
INTELLIGENCE_SCAN_HOURS=2
INTELLIGENCE_MAX_COMPANIES_PER_RUN=20
INTELLIGENCE_MAX_TEXT_CHARS=20000

# Supply-chain discovery reads stored documents. It does not fetch pages.
SUPPLY_CHAIN_SCAN_HOURS=24
SUPPLY_CHAIN_PORTFOLIO_INTERVAL_HOURS=24
SUPPLY_CHAIN_DEEP_INTERVAL_HOURS=24
SUPPLY_CHAIN_WATCHED_INTERVAL_HOURS=48
SUPPLY_CHAIN_MAX_COMPANIES_PER_RUN=20
SUPPLY_CHAIN_LOOKBACK_DAYS=30

# Candidate verification reads structured identifiers. It does not call a model.
DISCOVERY_VERIFY_MAX_PER_RUN=20
DISCOVERY_VERIFY_SCAN_HOURS=24
DISCOVERY_VERIFY_MIN_CONFIDENCE=75

# Discovery expansion collects structured sources for a promoted company. It does not promote candidates.
DISCOVERY_MAX_DEPTH=3
DISCOVERY_EXPANSION_MAX_PER_RUN=20
DISCOVERY_EXPANSION_SCAN_HOURS=24
DISCOVERY_EXPANSION_ANALYZED_HOURS=48

# Web login cookie. Set true only when the site is served over HTTPS.
WEB_COOKIE_SECURE=false

# AI document analysis. Core uses local GPU queue (never loads GGUF itself).
# Use stub only for offline CI / unit tests without a GPU worker.
AI_PROVIDER=local
AI_MODEL_NAME=Qwen2.5-1.5B-Instruct-Q4_K_M
AI_MODEL_PATH=
AI_MODEL_CACHE=/models
AI_MODEL_FILENAME=
AI_MAX_CONTEXT=4096
AI_MAX_OUTPUT_TOKENS=768
AI_MAX_INPUT_CHARS=12000
AI_MIN_CONTENT_CHARS=500
AI_TEMPERATURE=0
AI_GPU_LAYERS=20

# Intelligence supervision: stale after N poll intervals, never sooner than floor hours.
INTELLIGENCE_STALE_POLL_MULTIPLIER=2
INTELLIGENCE_STALE_MIN_HOURS=24
# Dashboard principal failed-job counter window.
JOBS_FAILED_RECENT_HOURS=24
