SENTINEL_CORE_HOST=192.168.1.116
SENTINEL_REDIS_HOST=192.168.1.116
SENTINEL_REDIS_PORT=6379
GPU_WORKER_NAME=sentinel-gpu-01
GPU_QUEUE=gpu
GPU_DEVICE=0
AI_MODEL_CACHE=/home/eric/sentinel-models
AI_PROVIDER=local
AI_MODEL_NAME=Qwen2.5-1.5B-Instruct-Q4_K_M
AI_MODEL_PATH=
AI_MODEL_FILENAME=
AI_MAX_CONTEXT=4096
AI_MAX_OUTPUT_TOKENS=768
AI_TEMPERATURE=0
AI_GPU_LAYERS=20
SENTINEL_AI_STUB=0
LOG_LEVEL=INFO

# Tunnel SSH local. Le worker Docker utilise 127.0.0.1 et ce port, jamais l'IP LAN.
GPU_REDIS_LOCAL_PORT=6380
SENTINEL_CORE_SSH_USER=sentinel
SENTINEL_CORE_SSH_PORT=22
# Défaut si vide : ~/.ssh/sentinel_gpu
SENTINEL_SSH_KEY=
